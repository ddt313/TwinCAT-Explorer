!out/webview/**
# The browser build (vscode.dev): one bundle, scripts/build-web.js.
!out/web/extension.js
# The MCP server ships bundled: its modules in out/src/mcp would need node_modules.
!out/mcp/**
!out/xae/**
# The browser extension (browser/) is built and loaded on its own; the unit tests compile its model to out/browser.
browser/**
out/browser/**
