{
  "manifest_version": 3,
  "name": "Explorer for TwinCAT",
  "version": "0.4.0",
  "key": "",
  "description": "Shows the TwinCAT files of GitHub, GitLab and Bitbucket reviews as objects and as an XAE-like tree, instead of XML. Read-only.",
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "Explorer for TwinCAT", "default_icon": { "128": "icon.png" } },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://gitlab.com/*", "https://bitbucket.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "scripting", "activeTab", "alarms"],
  "host_permissions": [
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://patch-diff.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://gitlab.com/*",
    "https://bitbucket.org/*",
    "https://api.bitbucket.org/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "web_accessible_resources": [
    { "resources": ["viewer.html", "tree.html"], "matches": ["https://*/*", "http://*/*"] }
  ]
}
