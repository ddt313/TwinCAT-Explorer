{
  "name": "explorer-for-twincat",
  "displayName": "Explorer for TwinCAT",
  "description": "XAE-like TwinCAT PLC project tree, an XAE-like declaration/implementation split editor and Structured Text language features",
  "version": "0.14.1",
  "publisher": "thanhdang",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ddt313/TwinCAT-Explorer.git"
  },
  "bugs": {
    "url": "https://github.com/ddt313/TwinCAT-Explorer/issues"
  },
  "homepage": "https://github.com/ddt313/TwinCAT-Explorer#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "TwinCAT",
    "Beckhoff",
    "PLC",
    "Structured Text",
    "IEC 61131-3",
    "XAE",
    "TcPOU",
    "automation"
  ],
  "activationEvents": [
    "workspaceContains:**/*.tsproj",
    "onFileSystem:twincat",
    "onFileSystem:twincat-diff",
    "onCustomEditor:twincatExplorer.objectEditor",
    "onNotebook:twincat-object",
    "onNotebook:twincat-diff",
    "onNotebook:twincat-file",
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "twincat-st",
        "aliases": [
          "TwinCAT Structured Text"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "twincat-object",
        "aliases": [
          "TwinCAT Object"
        ],
        "extensions": [
          ".tcobj"
        ]
      }
    ],
    "grammars": [
      {
        "language": "twincat-st",
        "scopeName": "source.twincat-st",
        "path": "./syntaxes/twincat-st.tmLanguage.json"
      }
    ],
    "notebooks": [
      {
        "type": "twincat-object",
        "displayName": "TwinCAT Object (Notebook)",
        "selector": [
          {
            "filenamePattern": "*.tcobj"
          }
        ],
        "priority": "option"
      },
      {
        "type": "twincat-diff",
        "displayName": "TwinCAT File Changes",
        "selector": [
          {
            "filenamePattern": "*.tcfile"
          }
        ],
        "priority": "default"
      },
      {
        "type": "twincat-file",
        "displayName": "TwinCAT File (Notebook)",
        "selector": [
          {
            "filenamePattern": "*.TcPOU"
          },
          {
            "filenamePattern": "*.TcDUT"
          },
          {
            "filenamePattern": "*.TcGVL"
          },
          {
            "filenamePattern": "*.TcIO"
          }
        ],
        "priority": "option"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "twincat",
        "formatting": {
          "label": "${query.label}",
          "separator": "/"
        }
      },
      {
        "scheme": "twincat-loc",
        "formatting": {
          "label": "${query.label}",
          "separator": "/"
        }
      },
      {
        "scheme": "twincat-diff",
        "formatting": {
          "label": "${query.label}",
          "separator": "/"
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "twincatExplorer.tree",
          "name": "TwinCAT",
          "icon": "media/twincat.svg",
          "contextualTitle": "Explorer for TwinCAT",
          "when": "twincatExplorer.hasProjects"
        }
      ],
      "scm": [
        {
          "id": "twincatExplorer.changes",
          "name": "TwinCAT Changes",
          "icon": "media/twincat.svg",
          "contextualTitle": "TwinCAT",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "id": "twincatExplorer.commits",
          "name": "TwinCAT Commits",
          "icon": "media/twincat.svg",
          "contextualTitle": "TwinCAT",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "id": "twincatExplorer.history",
          "name": "TwinCAT History",
          "icon": "media/twincat.svg",
          "contextualTitle": "TwinCAT",
          "when": "twincatExplorer.hasProjects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "twincatExplorer.tree",
        "contents": "Loading TwinCAT projects..."
      }
    ],
    "commands": [
      {
        "command": "twincatExplorer.refresh",
        "title": "Refresh",
        "category": "TwinCAT",
        "icon": "$(refresh)"
      },
      {
        "command": "twincatExplorer.open",
        "title": "Open",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.openToSide",
        "title": "Open to the Side",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.openXml",
        "title": "Open XML",
        "category": "TwinCAT",
        "icon": "$(file-code)"
      },
      {
        "command": "twincatExplorer.revealInTree",
        "title": "Reveal in TwinCAT Explorer",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.revealActive",
        "title": "Reveal Active Editor",
        "category": "TwinCAT",
        "icon": "$(target)"
      },
      {
        "command": "twincatExplorer.openChanges",
        "title": "Open Changes as TwinCAT Notebook",
        "category": "TwinCAT",
        "icon": "$(git-compare)"
      },
      {
        "command": "twincatExplorer.compareWithRef",
        "title": "Compare with Git Ref as TwinCAT Notebook...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.showChanges",
        "title": "Show Changes vs HEAD",
        "category": "TwinCAT",
        "icon": "$(git-compare)"
      },
      {
        "command": "twincatExplorer.hideChanges",
        "title": "Hide Changes vs HEAD",
        "category": "TwinCAT",
        "icon": "$(eye-closed)"
      },
      {
        "command": "twincatExplorer.changes.refresh",
        "title": "Refresh",
        "category": "TwinCAT Changes",
        "icon": "$(refresh)"
      },
      {
        "command": "twincatExplorer.changes.showUncommitted",
        "title": "Show Uncommitted Changes (vs HEAD)",
        "category": "TwinCAT Changes",
        "icon": "$(git-commit)"
      },
      {
        "command": "twincatExplorer.changes.showBranch",
        "title": "Show Branch Changes (vs Merge Base)",
        "category": "TwinCAT Changes",
        "icon": "$(git-branch)"
      },
      {
        "command": "twincatExplorer.changes.compareBranchWith",
        "title": "Compare Branch With...",
        "category": "TwinCAT Changes",
        "icon": "$(git-compare)"
      },
      {
        "command": "twincatExplorer.changes.open",
        "title": "Open Changes",
        "category": "TwinCAT Changes"
      },
      {
        "command": "twincatExplorer.changes.discard",
        "title": "Discard Changes",
        "category": "TwinCAT Changes",
        "icon": "$(discard)"
      },
      {
        "command": "twincatExplorer.changes.stage",
        "title": "Stage Changes",
        "category": "TwinCAT Changes",
        "icon": "$(add)"
      },
      {
        "command": "twincatExplorer.changes.unstage",
        "title": "Unstage Changes",
        "category": "TwinCAT Changes",
        "icon": "$(remove)"
      },
      {
        "command": "twincatExplorer.changes.stageAll",
        "title": "Stage All Changes",
        "category": "TwinCAT Changes",
        "icon": "$(add)"
      },
      {
        "command": "twincatExplorer.changes.unstageAll",
        "title": "Unstage All Changes",
        "category": "TwinCAT Changes",
        "icon": "$(remove)"
      },
      {
        "command": "twincatExplorer.changes.openNotebook",
        "title": "Open Changes as TwinCAT Notebook",
        "category": "TwinCAT Changes",
        "icon": "$(notebook)"
      },
      {
        "command": "twincatExplorer.commits.refresh",
        "title": "Refresh",
        "category": "TwinCAT Commits",
        "icon": "$(refresh)"
      },
      {
        "command": "twincatExplorer.commits.open",
        "title": "Open Changes",
        "category": "TwinCAT Commits"
      },
      {
        "command": "twincatExplorer.commits.openText",
        "title": "Open Changes",
        "category": "TwinCAT Commits"
      },
      {
        "command": "twincatExplorer.commits.openNotebook",
        "title": "Open Changes as TwinCAT Notebook",
        "category": "TwinCAT Commits",
        "icon": "$(notebook)"
      },
      {
        "command": "twincatExplorer.commits.loadMore",
        "title": "Load More Commits",
        "category": "TwinCAT Commits"
      },
      {
        "command": "twincatExplorer.commits.copySha",
        "title": "Copy Commit SHA",
        "category": "TwinCAT Commits"
      },
      {
        "command": "twincatExplorer.commits.copyMessage",
        "title": "Copy Commit Message",
        "category": "TwinCAT Commits"
      },
      {
        "command": "twincatExplorer.commitDiff.openCurrent",
        "title": "Open Current Version",
        "category": "TwinCAT",
        "icon": "$(go-to-file)"
      },
      {
        "command": "twincatExplorer.history.show",
        "title": "Show History",
        "category": "TwinCAT",
        "icon": "$(history)"
      },
      {
        "command": "twincatExplorer.navigateBack",
        "title": "Go Back",
        "category": "TwinCAT",
        "icon": "$(arrow-left)",
        "enablement": "twincatExplorer.canNavigateBack"
      },
      {
        "command": "twincatExplorer.navigateForward",
        "title": "Go Forward",
        "category": "TwinCAT",
        "icon": "$(arrow-right)",
        "enablement": "twincatExplorer.canNavigateForward"
      },
      {
        "command": "twincatExplorer.history.refresh",
        "title": "Refresh",
        "category": "TwinCAT History",
        "icon": "$(refresh)"
      },
      {
        "command": "twincatExplorer.history.pin",
        "title": "Pin to This Object",
        "category": "TwinCAT History",
        "icon": "$(pin)"
      },
      {
        "command": "twincatExplorer.history.unpin",
        "title": "Unpin (Follow the Active Editor)",
        "category": "TwinCAT History",
        "icon": "$(pinned)"
      },
      {
        "command": "twincatExplorer.history.open",
        "title": "Open Changes",
        "category": "TwinCAT History"
      },
      {
        "command": "twincatExplorer.history.openWorking",
        "title": "Open Changes",
        "category": "TwinCAT History"
      },
      {
        "command": "twincatExplorer.history.compareWithWorking",
        "title": "Compare with Working Version",
        "category": "TwinCAT History",
        "icon": "$(compare-changes)"
      },
      {
        "command": "twincatExplorer.history.loadMore",
        "title": "Load More",
        "category": "TwinCAT History"
      },
      {
        "command": "twincatExplorer.toggleBlame",
        "title": "Toggle Line Blame",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.goToObject",
        "title": "Go to Object...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.goToImplementation",
        "title": "Go to Implementation",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.showTypeHierarchy",
        "title": "Show Type Hierarchy",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.checkWorkspace",
        "title": "Check All Structured Text",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.copyName",
        "title": "Copy Name",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.addPou",
        "title": "Add POU...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.addDut",
        "title": "Add DUT...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.addGvl",
        "title": "Add Global Variable List...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.addInterface",
        "title": "Add Interface...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.newFolder",
        "title": "New Folder...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.addExistingItem",
        "title": "Add Existing Item...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.addExistingFolderContent",
        "title": "Add Existing Folder Content...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.addLibrary",
        "title": "Add Library...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.rename",
        "title": "Rename...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.delete",
        "title": "Delete",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.moveToFolder",
        "title": "Move to Folder...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.addMethod",
        "title": "Add Method...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.addProperty",
        "title": "Add Property...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.addAction",
        "title": "Add Action...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.implementInterfaces",
        "title": "Implement Interfaces...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.autoDeclare",
        "title": "Auto Declare...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.hideNotebookToolbars",
        "title": "Hide Notebook Toolbars (XAE-like Layout)",
        "category": "TwinCAT"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "twincatExplorer.open",
          "when": "false"
        },
        {
          "command": "twincatExplorer.openToSide",
          "when": "false"
        },
        {
          "command": "twincatExplorer.copyName",
          "when": "false"
        },
        {
          "command": "twincatExplorer.rename",
          "when": "false"
        },
        {
          "command": "twincatExplorer.delete",
          "when": "false"
        },
        {
          "command": "twincatExplorer.moveToFolder",
          "when": "false"
        },
        {
          "command": "twincatExplorer.addPou",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.addDut",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.addGvl",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.addInterface",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.newFolder",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.addExistingItem",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.addExistingFolderContent",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.addLibrary",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.addMethod",
          "when": "resourceScheme == twincat || resourceExtname =~ /^\\.(TcPOU|TcIO)$/i"
        },
        {
          "command": "twincatExplorer.addProperty",
          "when": "resourceScheme == twincat || resourceExtname =~ /^\\.(TcPOU|TcIO)$/i"
        },
        {
          "command": "twincatExplorer.addAction",
          "when": "resourceScheme == twincat || resourceExtname =~ /^\\.TcPOU$/i"
        },
        {
          "command": "twincatExplorer.implementInterfaces",
          "when": "resourceScheme == twincat || resourceExtname =~ /^\\.TcPOU$/i"
        },
        {
          "command": "twincatExplorer.goToImplementation",
          "when": "false"
        },
        {
          "command": "twincatExplorer.showTypeHierarchy",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.autoDeclare",
          "when": "activeCustomEditorId == twincatExplorer.objectEditor || editorLangId == twincat-st"
        },
        {
          "command": "twincatExplorer.openXml",
          "when": "resourceScheme == twincat || resourceScheme == twincat-diff"
        },
        {
          "command": "twincatExplorer.openChanges",
          "when": "resourceExtname =~ /^\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i || resourceScheme == twincat"
        },
        {
          "command": "twincatExplorer.compareWithRef",
          "when": "resourceExtname =~ /^\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i || resourceScheme == twincat"
        },
        {
          "command": "twincatExplorer.showChanges",
          "when": "activeCustomEditorId == twincatExplorer.objectEditor && !twincatExplorer.changesMode"
        },
        {
          "command": "twincatExplorer.hideChanges",
          "when": "activeCustomEditorId == twincatExplorer.objectEditor && twincatExplorer.changesMode"
        },
        {
          "command": "twincatExplorer.revealInTree",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.changes.open",
          "when": "false"
        },
        {
          "command": "twincatExplorer.changes.discard",
          "when": "false"
        },
        {
          "command": "twincatExplorer.changes.stage",
          "when": "false"
        },
        {
          "command": "twincatExplorer.changes.unstage",
          "when": "false"
        },
        {
          "command": "twincatExplorer.changes.stageAll",
          "when": "false"
        },
        {
          "command": "twincatExplorer.changes.unstageAll",
          "when": "false"
        },
        {
          "command": "twincatExplorer.changes.openNotebook",
          "when": "false"
        },
        {
          "command": "twincatExplorer.changes.refresh",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.changes.showUncommitted",
          "when": "twincatExplorer.hasProjects && twincatExplorer.changesScope == branch"
        },
        {
          "command": "twincatExplorer.changes.showBranch",
          "when": "twincatExplorer.hasProjects && twincatExplorer.changesScope != branch"
        },
        {
          "command": "twincatExplorer.changes.compareBranchWith",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.commits.open",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.openText",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.openNotebook",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.loadMore",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.copySha",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.copyMessage",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.refresh",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.commitDiff.openCurrent",
          "when": "activeWebviewPanelId == twincatExplorer.commitDiff"
        },
        {
          "command": "twincatExplorer.history.show",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.history.refresh",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.history.pin",
          "when": "twincatExplorer.hasProjects && !twincatExplorer.historyPinned"
        },
        {
          "command": "twincatExplorer.history.unpin",
          "when": "twincatExplorer.hasProjects && twincatExplorer.historyPinned"
        },
        {
          "command": "twincatExplorer.history.open",
          "when": "false"
        },
        {
          "command": "twincatExplorer.history.openWorking",
          "when": "false"
        },
        {
          "command": "twincatExplorer.history.compareWithWorking",
          "when": "false"
        },
        {
          "command": "twincatExplorer.history.loadMore",
          "when": "false"
        },
        {
          "command": "twincatExplorer.toggleBlame",
          "when": "twincatExplorer.hasProjects"
        }
      ],
      "view/title": [
        {
          "command": "twincatExplorer.revealActive",
          "when": "view == twincatExplorer.tree",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.refresh",
          "when": "view == twincatExplorer.tree",
          "group": "navigation@2"
        },
        {
          "command": "twincatExplorer.changes.showBranch",
          "when": "view == twincatExplorer.changes && twincatExplorer.changesScope != branch",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.changes.showUncommitted",
          "when": "view == twincatExplorer.changes && twincatExplorer.changesScope == branch",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.changes.compareBranchWith",
          "when": "view == twincatExplorer.changes",
          "group": "navigation@2"
        },
        {
          "command": "twincatExplorer.changes.refresh",
          "when": "view == twincatExplorer.changes",
          "group": "navigation@3"
        },
        {
          "command": "twincatExplorer.commits.refresh",
          "when": "view == twincatExplorer.commits",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.history.pin",
          "when": "view == twincatExplorer.history && !twincatExplorer.historyPinned",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.history.unpin",
          "when": "view == twincatExplorer.history && twincatExplorer.historyPinned",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.history.refresh",
          "when": "view == twincatExplorer.history",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "twincatExplorer.openToSide",
          "when": "view == twincatExplorer.tree && viewItem =~ /openable/",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.openXml",
          "when": "view == twincatExplorer.tree && viewItem =~ /hasFile/",
          "group": "navigation@2"
        },
        {
          "command": "twincatExplorer.openChanges",
          "when": "view == twincatExplorer.tree && viewItem =~ /stFile/",
          "group": "navigation@3"
        },
        {
          "command": "twincatExplorer.compareWithRef",
          "when": "view == twincatExplorer.tree && viewItem =~ /stFile/",
          "group": "navigation@4"
        },
        {
          "command": "twincatExplorer.history.show",
          "when": "view == twincatExplorer.tree && viewItem =~ /openable/",
