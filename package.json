{
  "name": "twincat-explorer",
  "displayName": "TwinCAT Explorer",
  "description": "XAE-like TwinCAT PLC project tree, an XAE-like declaration/implementation split editor and Structured Text language features",
  "version": "0.8.0",
  "publisher": "thanhdang",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.tsproj",
    "onFileSystem:twincat",
    "onFileSystem:twincat-diff",
    "onCustomEditor:twincatExplorer.objectEditor",
    "onNotebook:twincat-object",
    "onNotebook:twincat-diff",
    "onNotebook:twincat-file",
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "twincat-st",
        "aliases": [
          "TwinCAT Structured Text"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "twincat-object",
        "aliases": [
          "TwinCAT Object"
        ],
        "extensions": [
          ".tcobj"
        ]
      }
    ],
    "grammars": [
      {
        "language": "twincat-st",
        "scopeName": "source.twincat-st",
        "path": "./syntaxes/twincat-st.tmLanguage.json"
      }
    ],
    "notebooks": [
      {
        "type": "twincat-object",
        "displayName": "TwinCAT Object (Notebook)",
        "selector": [
          {
            "filenamePattern": "*.tcobj"
          }
        ],
        "priority": "option"
      },
      {
        "type": "twincat-diff",
        "displayName": "TwinCAT File Changes",
        "selector": [
          {
            "filenamePattern": "*.tcfile"
          }
        ],
        "priority": "default"
      },
      {
        "type": "twincat-file",
        "displayName": "TwinCAT File (Notebook)",
        "selector": [
          {
            "filenamePattern": "*.TcPOU"
          },
          {
            "filenamePattern": "*.TcDUT"
          },
          {
            "filenamePattern": "*.TcGVL"
          },
          {
            "filenamePattern": "*.TcIO"
          }
        ],
        "priority": "option"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "twincat",
        "formatting": {
          "label": "${query.label}",
          "separator": "/"
        }
      },
      {
        "scheme": "twincat-loc",
        "formatting": {
          "label": "${query.label}",
          "separator": "/"
        }
      },
      {
        "scheme": "twincat-diff",
        "formatting": {
          "label": "${query.label}",
          "separator": "/"
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "twincatExplorer.tree",
          "name": "TwinCAT",
          "icon": "media/twincat.svg",
          "contextualTitle": "TwinCAT Explorer",
          "when": "twincatExplorer.hasProjects"
        }
      ],
      "scm": [
        {
          "id": "twincatExplorer.changes",
          "name": "TwinCAT Changes",
          "icon": "media/twincat.svg",
          "contextualTitle": "TwinCAT",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "id": "twincatExplorer.commits",
          "name": "TwinCAT Commits",
          "icon": "media/twincat.svg",
          "contextualTitle": "TwinCAT",
          "when": "twincatExplorer.hasProjects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "twincatExplorer.tree",
        "contents": "Loading TwinCAT projects..."
      }
    ],
    "commands": [
      {
        "command": "twincatExplorer.refresh",
        "title": "Refresh",
        "category": "TwinCAT",
        "icon": "$(refresh)"
      },
      {
        "command": "twincatExplorer.open",
        "title": "Open",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.openToSide",
        "title": "Open to the Side",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.openXml",
        "title": "Open XML",
        "category": "TwinCAT",
        "icon": "$(file-code)"
      },
      {
        "command": "twincatExplorer.revealInTree",
        "title": "Reveal in TwinCAT Explorer",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.revealActive",
        "title": "Reveal Active Editor",
        "category": "TwinCAT",
        "icon": "$(target)"
      },
      {
        "command": "twincatExplorer.openChanges",
        "title": "Open Changes as TwinCAT Notebook",
        "category": "TwinCAT",
        "icon": "$(git-compare)"
      },
      {
        "command": "twincatExplorer.compareWithRef",
        "title": "Compare with Git Ref as TwinCAT Notebook...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.showChanges",
        "title": "Show Changes vs HEAD",
        "category": "TwinCAT",
        "icon": "$(git-compare)"
      },
      {
        "command": "twincatExplorer.hideChanges",
        "title": "Hide Changes vs HEAD",
        "category": "TwinCAT",
        "icon": "$(eye-closed)"
      },
      {
        "command": "twincatExplorer.changes.refresh",
        "title": "Refresh",
        "category": "TwinCAT Changes",
        "icon": "$(refresh)"
      },
      {
        "command": "twincatExplorer.changes.showUncommitted",
        "title": "Show Uncommitted Changes (vs HEAD)",
        "category": "TwinCAT Changes",
        "icon": "$(git-commit)"
      },
      {
        "command": "twincatExplorer.changes.showBranch",
        "title": "Show Branch Changes (vs Merge Base)",
        "category": "TwinCAT Changes",
        "icon": "$(git-branch)"
      },
      {
        "command": "twincatExplorer.changes.compareBranchWith",
        "title": "Compare Branch With...",
        "category": "TwinCAT Changes",
        "icon": "$(git-compare)"
      },
      {
        "command": "twincatExplorer.changes.open",
        "title": "Open Changes",
        "category": "TwinCAT Changes"
      },
      {
        "command": "twincatExplorer.changes.discard",
        "title": "Discard Changes",
        "category": "TwinCAT Changes",
        "icon": "$(discard)"
      },
      {
        "command": "twincatExplorer.changes.openNotebook",
        "title": "Open Changes as TwinCAT Notebook",
        "category": "TwinCAT Changes",
        "icon": "$(notebook)"
      },
      {
        "command": "twincatExplorer.commits.refresh",
        "title": "Refresh",
        "category": "TwinCAT Commits",
        "icon": "$(refresh)"
      },
      {
        "command": "twincatExplorer.commits.open",
        "title": "Open Changes",
        "category": "TwinCAT Commits"
      },
      {
        "command": "twincatExplorer.commits.openText",
        "title": "Open Changes",
        "category": "TwinCAT Commits"
      },
      {
        "command": "twincatExplorer.commits.openNotebook",
        "title": "Open Changes as TwinCAT Notebook",
        "category": "TwinCAT Commits",
        "icon": "$(notebook)"
      },
      {
        "command": "twincatExplorer.commits.loadMore",
        "title": "Load More Commits",
        "category": "TwinCAT Commits"
      },
      {
        "command": "twincatExplorer.commits.copySha",
        "title": "Copy Commit SHA",
        "category": "TwinCAT Commits"
      },
      {
        "command": "twincatExplorer.commits.copyMessage",
        "title": "Copy Commit Message",
        "category": "TwinCAT Commits"
      },
      {
        "command": "twincatExplorer.commitDiff.openCurrent",
        "title": "Open Current Version",
        "category": "TwinCAT",
        "icon": "$(go-to-file)"
      },
      {
        "command": "twincatExplorer.goToObject",
        "title": "Go to Object...",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.checkWorkspace",
        "title": "Check All Structured Text",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.copyName",
        "title": "Copy Name",
        "category": "TwinCAT"
      },
      {
        "command": "twincatExplorer.hideNotebookToolbars",
        "title": "Hide Notebook Toolbars (XAE-like Layout)",
        "category": "TwinCAT"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "twincatExplorer.open",
          "when": "false"
        },
        {
          "command": "twincatExplorer.openToSide",
          "when": "false"
        },
        {
          "command": "twincatExplorer.copyName",
          "when": "false"
        },
        {
          "command": "twincatExplorer.openXml",
          "when": "resourceScheme == twincat || resourceScheme == twincat-diff"
        },
        {
          "command": "twincatExplorer.openChanges",
          "when": "resourceExtname =~ /^\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i || resourceScheme == twincat"
        },
        {
          "command": "twincatExplorer.compareWithRef",
          "when": "resourceExtname =~ /^\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i || resourceScheme == twincat"
        },
        {
          "command": "twincatExplorer.showChanges",
          "when": "activeCustomEditorId == twincatExplorer.objectEditor && !twincatExplorer.changesMode"
        },
        {
          "command": "twincatExplorer.hideChanges",
          "when": "activeCustomEditorId == twincatExplorer.objectEditor && twincatExplorer.changesMode"
        },
        {
          "command": "twincatExplorer.revealInTree",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.changes.open",
          "when": "false"
        },
        {
          "command": "twincatExplorer.changes.discard",
          "when": "false"
        },
        {
          "command": "twincatExplorer.changes.openNotebook",
          "when": "false"
        },
        {
          "command": "twincatExplorer.changes.refresh",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.changes.showUncommitted",
          "when": "twincatExplorer.hasProjects && twincatExplorer.changesScope == branch"
        },
        {
          "command": "twincatExplorer.changes.showBranch",
          "when": "twincatExplorer.hasProjects && twincatExplorer.changesScope != branch"
        },
        {
          "command": "twincatExplorer.changes.compareBranchWith",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.commits.open",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.openText",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.openNotebook",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.loadMore",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.copySha",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.copyMessage",
          "when": "false"
        },
        {
          "command": "twincatExplorer.commits.refresh",
          "when": "twincatExplorer.hasProjects"
        },
        {
          "command": "twincatExplorer.commitDiff.openCurrent",
          "when": "activeWebviewPanelId == twincatExplorer.commitDiff"
        }
      ],
      "view/title": [
        {
          "command": "twincatExplorer.revealActive",
          "when": "view == twincatExplorer.tree",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.refresh",
          "when": "view == twincatExplorer.tree",
          "group": "navigation@2"
        },
        {
          "command": "twincatExplorer.changes.showBranch",
          "when": "view == twincatExplorer.changes && twincatExplorer.changesScope != branch",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.changes.showUncommitted",
          "when": "view == twincatExplorer.changes && twincatExplorer.changesScope == branch",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.changes.compareBranchWith",
          "when": "view == twincatExplorer.changes",
          "group": "navigation@2"
        },
        {
          "command": "twincatExplorer.changes.refresh",
          "when": "view == twincatExplorer.changes",
          "group": "navigation@3"
        },
        {
          "command": "twincatExplorer.commits.refresh",
          "when": "view == twincatExplorer.commits",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "twincatExplorer.openToSide",
          "when": "view == twincatExplorer.tree && viewItem =~ /openable/",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.openXml",
          "when": "view == twincatExplorer.tree && viewItem =~ /hasFile/",
          "group": "navigation@2"
        },
        {
          "command": "twincatExplorer.openChanges",
          "when": "view == twincatExplorer.tree && viewItem =~ /stFile/",
          "group": "navigation@3"
        },
        {
          "command": "twincatExplorer.compareWithRef",
          "when": "view == twincatExplorer.tree && viewItem =~ /stFile/",
          "group": "navigation@4"
        },
        {
          "command": "twincatExplorer.copyName",
          "when": "view == twincatExplorer.tree && viewItem =~ /named/",
          "group": "9_copy@1"
        },
        {
          "command": "twincatExplorer.changes.openNotebook",
          "when": "view == twincatExplorer.changes && viewItem =~ /notebookDiff/",
          "group": "inline@1"
        },
        {
          "command": "twincatExplorer.changes.discard",
          "when": "view == twincatExplorer.changes && viewItem =~ /discard-/",
          "group": "inline@2"
        },
        {
          "command": "twincatExplorer.changes.openNotebook",
          "when": "view == twincatExplorer.changes && viewItem =~ /notebookDiff/",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.changes.discard",
          "when": "view == twincatExplorer.changes && viewItem =~ /discard-/",
          "group": "1_modification@1"
        },
        {
          "command": "twincatExplorer.commits.openNotebook",
          "when": "view == twincatExplorer.commits && viewItem =~ /notebookDiff/",
          "group": "inline@1"
        },
        {
          "command": "twincatExplorer.commits.openNotebook",
          "when": "view == twincatExplorer.commits && viewItem =~ /notebookDiff/",
          "group": "navigation@1"
        },
        {
          "command": "twincatExplorer.commits.copySha",
          "when": "view == twincatExplorer.commits && viewItem =~ /^commit/",
          "group": "9_copy@1"
        },
        {
          "command": "twincatExplorer.commits.copyMessage",
          "when": "view == twincatExplorer.commits && viewItem =~ /^commit/",
          "group": "9_copy@2"
        }
      ],
      "editor/title": [
        {
          "command": "twincatExplorer.openXml",
          "when": "resourceScheme == twincat",
          "group": "navigation@90"
        },
        {
          "command": "twincatExplorer.showChanges",
          "when": "resourceScheme == twincat && activeCustomEditorId == twincatExplorer.objectEditor && !twincatExplorer.changesMode",
          "group": "navigation@91"
        },
        {
          "command": "twincatExplorer.hideChanges",
          "when": "resourceScheme == twincat && activeCustomEditorId == twincatExplorer.objectEditor && twincatExplorer.changesMode",
          "group": "navigation@91"
        },
        {
          "command": "twincatExplorer.openChanges",
          "when": "resourceScheme == twincat && activeCustomEditorId != twincatExplorer.objectEditor",
          "group": "navigation@91"
        },
        {
          "command": "twincatExplorer.openChanges",
          "when": "resourceScheme == twincat && activeCustomEditorId == twincatExplorer.objectEditor",
          "group": "1_twincat@1"
        },
        {
          "command": "twincatExplorer.commitDiff.openCurrent",
          "when": "activeWebviewPanelId == twincatExplorer.commitDiff",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "twincatExplorer.openChanges",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i",
          "group": "3_compare@1"
        },
        {
          "command": "twincatExplorer.revealInTree",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO)$/i || resourceScheme == twincat",
          "group": "2_files@90"
        }
      ],
      "explorer/context": [
        {
          "command": "twincatExplorer.openChanges",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i",
          "group": "3_compare@90"
        },
        {
          "command": "twincatExplorer.revealInTree",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO)$/i",
          "group": "navigation@90"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "twincatExplorer.openChanges",
          "when": "scmProvider == git && scmResourceGroup =~ /^(index|workingTree|untracked)$/",
          "group": "7_twincat@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "twincatExplorer.goToObject",
        "key": "ctrl+alt+t",
        "when": "twincatExplorer.hasProjects"
      }
    ],
    "configuration": {
      "title": "TwinCAT Explorer",
      "properties": {
        "twincatExplorer.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Select the active TwinCAT object or file in the TwinCAT tree."
        },
        "twincatExplorer.foldersFirst": {
          "type": "boolean",
          "default": true,
          "description": "Sort folders before objects in the TwinCAT tree."
        },
        "twincatExplorer.editor": {
          "type": "string",
          "enum": [
            "split",
            "notebook"
          ],
          "enumDescriptions": [
            "XAE-like editor: Declaration above Implementation, each with its own scroll bar, resizable.",
            "Notebook with one cell per section."
          ],
          "default": "split",
          "description": "Editor that TwinCAT objects open in from the TwinCAT tree, Go to Object and go to definition. Either can also be chosen per tab with Reopen Editor With."
        },
        "twincatExplorer.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Report Structured Text problems (syntax, unknown identifiers, unknown members) in open TwinCAT editors and notebooks."
        },
        "twincatExplorer.diagnostics.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Identifiers that are never reported as unknown (for example symbols of a library without a stub)."
        },
        "twincatExplorer.stubFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra Structured Text stub files with library declarations (absolute paths or paths relative to the first workspace folder). Wrap declarations in LIBRARY <Name> ... END_LIBRARY."
        },
        "twincatExplorer.exclude": {
          "type": "string",
          "default": "**/{node_modules,.git,.claude,_Boot,_CompileInfo,_Libraries}/**",
          "description": "Glob of folders ignored when searching for .tsproj files. Folders whose name starts with a dot (for example .claude/worktrees) are always ignored."
        }
      }
    },
    "configurationDefaults": {
      "[twincat-st]": {
        "editor.wordBasedSuggestions": "off"
      },
      "notebook.cellToolbarLocation": {
        "default": "right",
        "twincat-object": "hidden",
        "twincat-file": "hidden"
      },
      "[twincat-object]": {
        "files.trimTrailingWhitespace": false,
        "files.insertFinalNewline": false,
        "files.trimFinalNewlines": false,
        "editor.formatOnSave": false,
        "files.encoding": "utf8",
        "files.autoGuessEncoding": false
      }
    },
    "customEditors": [
      {
        "viewType": "twincatExplorer.objectEditor",
        "displayName": "TwinCAT Object (Split Editor)",
        "selector": [
          {
            "filenamePattern": "twincat:/**/*.tcobj"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && tsc -p src/webview && node scripts/build-webview.js",
    "watch": "tsc -w -p .",
    "test:unit": "node --test --test-reporter=spec \"out/test/unit/*.test.js\"",
    "test": "npm run compile && npm run test:unit",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "vscode:prepublish": "npm run compile",
    "install:local": "node scripts/install.js",
    "build:webview": "node scripts/build-webview.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "0.28.2",
    "monaco-editor": "0.55.1",
    "typescript": "^5.6.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
