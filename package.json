    "keybindings": [
      {
        "command": "twincatExplorer.navigateBack",
        "key": "alt+left",
        "mac": "ctrl+-",
        "when": "twincatExplorer.canNavigateBack && (resourceScheme == twincat || notebookType == twincat-object || focusedView == twincatExplorer.tree)"
      },
      {
        "command": "twincatExplorer.navigateForward",
        "key": "alt+right",
        "mac": "ctrl+shift+-",
        "when": "twincatExplorer.canNavigateForward && (resourceScheme == twincat || notebookType == twincat-object || focusedView == twincatExplorer.tree)"
      },
      {
        "command": "twincatExplorer.goToObject",
        "key": "ctrl+alt+t",
        "when": "twincatExplorer.hasProjects"
      },
      {
        "command": "twincatExplorer.autoDeclare",
        "key": "shift+f2",
        "when": "editorTextFocus && editorLangId == twincat-st"
      },
      {
        "command": "twincatExplorer.rename",
        "key": "f2",
        "when": "focusedView == twincatExplorer.tree && !inputFocus"
      },
      {
        "command": "twincatExplorer.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == twincatExplorer.tree && !inputFocus"
      }
    ],
    "configuration": {
      "title": "Explorer for TwinCAT",
      "properties": {
        "twincatExplorer.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Select the active TwinCAT object or file in the TwinCAT tree."
        },
        "twincatExplorer.foldersFirst": {
          "type": "boolean",
          "default": true,
          "description": "Sort folders before objects in the TwinCAT tree."
        },
        "twincatExplorer.editor": {
          "type": "string",
          "enum": [
            "split",
            "notebook"
          ],
          "enumDescriptions": [
            "XAE-like editor: Declaration above Implementation, each with its own scroll bar, resizable.",
            "Notebook with one cell per section."
          ],
          "default": "split",
          "description": "Editor that TwinCAT objects open in from the TwinCAT tree, Go to Object and go to definition. Either can also be chosen per tab with Reopen Editor With."
        },
        "twincatExplorer.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Report Structured Text problems (syntax, unknown identifiers, unknown members) in open TwinCAT editors and notebooks."
        },
        "twincatExplorer.diagnostics.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Identifiers that are never reported as unknown (for example symbols of a library without a stub)."
        },
        "twincatExplorer.stubFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra Structured Text stub files with library declarations (absolute paths or paths relative to the first workspace folder). Wrap declarations in LIBRARY <Name> ... END_LIBRARY."
        },
        "twincatExplorer.libraryRepositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Folders of TwinCAT library repositories (absolute paths) that Add Library... lists the libraries of, besides the system repository of TwinCAT 3.1.4026 (%ProgramData%\\Beckhoff\\TwinCAT\\PlcEngineering\\Managed Libraries) and of 3.1.4024 and older (%TWINCAT3DIR%Components\\Plc\\Managed Libraries). For the repositories added in XAE's Library Repository dialog."
        },
        "twincatExplorer.exclude": {
          "type": "string",
          "default": "**/{node_modules,.git,.claude,_Boot,_CompileInfo,_Libraries}/**",
          "description": "Glob of folders ignored when searching for .tsproj files. Folders whose name starts with a dot (for example .claude/worktrees) are always ignored."
        },
        "twincatExplorer.blame.currentLine": {
          "type": "boolean",
          "default": true,
          "description": "Show at the end of the current line of the split editor who last changed it, when, and the commit message (like GitLens' current line blame). Open Changes in its hover shows the commit's changes of the object."
        }
      }
    },
    "configurationDefaults": {
      "[twincat-st]": {
        "editor.wordBasedSuggestions": "off"
      },
      "notebook.cellToolbarLocation": {
        "default": "right",
        "twincat-object": "hidden",
        "twincat-file": "hidden"
      },
      "[twincat-object]": {
        "files.trimTrailingWhitespace": false,
        "files.insertFinalNewline": false,
        "files.trimFinalNewlines": false,
        "editor.formatOnSave": false,
        "files.encoding": "utf8",
        "files.autoGuessEncoding": false
      }
    },
    "customEditors": [
      {
        "viewType": "twincatExplorer.objectEditor",
        "displayName": "TwinCAT Object (Split Editor)",
        "selector": [
          {
            "filenamePattern": "twincat:/**/*.tcobj"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && tsc -p src/webview && node scripts/build-webview.js",
    "watch": "tsc -w -p .",
    "test:unit": "node --test --test-reporter=spec \"out/test/unit/*.test.js\"",
    "test": "npm run compile && npm run test:unit",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile",
    "install:local": "node scripts/install.js",
    "build:webview": "node scripts/build-webview.js",
    "build:browser": "tsc -p browser && node browser/build.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "0.28.2",
    "monaco-editor": "0.55.1",
    "typescript": "^5.6.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
