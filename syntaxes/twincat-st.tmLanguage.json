{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TwinCAT Structured Text",
  "scopeName": "source.twincat-st",
  "patterns": [
    { "include": "#comments" },
    { "include": "#pragmas" },
    { "include": "#strings" },
    { "include": "#literals" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.twincat-st", "match": "//.*$" },
        { "include": "#blockComment" },
        { "name": "comment.block.twincat-st", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "blockComment": {
      "name": "comment.block.twincat-st",
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "patterns": [{ "include": "#blockComment" }]
    },
    "pragmas": {
      "name": "meta.preprocessor.pragma.twincat-st",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.definition.pragma.twincat-st" } },
      "endCaptures": { "0": { "name": "punctuation.definition.pragma.twincat-st" } },
      "patterns": [
        { "name": "keyword.other.pragma.twincat-st", "match": "(?i)\\b(attribute|IF|ELSIF|ELSE|END_IF|defined|warning|error|info|text|library|region|endregion)\\b" },
        { "name": "string.quoted.single.twincat-st", "match": "'[^']*'" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.twincat-st",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.twincat-st", "match": "\\$([$'LNPRTlnprt]|[0-9A-Fa-f]{2})" }]
        },
        {
          "name": "string.quoted.double.twincat-st",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.twincat-st", "match": "\\$([$\"LNPRTlnprt]|[0-9A-Fa-f]{4})" }]
        }
      ]
    },
    "literals": {
      "patterns": [
        { "name": "constant.numeric.time.twincat-st", "match": "(?i)\\b(T|TIME|LT|LTIME|D|DATE|LD|LDATE|DT|DATE_AND_TIME|LDT|TOD|TIME_OF_DAY|LTOD)#[0-9A-Za-z_:.+\\-]+" },
        { "name": "constant.numeric.typed.twincat-st", "match": "(?i)\\b[A-Z_]\\w*#(\\d+#)?[0-9A-Fa-f_.]+(E[+\\-]?\\d+)?\\b" },
        { "name": "constant.numeric.based.twincat-st", "match": "\\b(2|8|16)#[0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.twincat-st", "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+\\-]?\\d+)?\\b" },
        { "name": "constant.language.boolean.twincat-st", "match": "(?i)\\b(TRUE|FALSE|NULL)\\b" },
        { "name": "variable.language.this.twincat-st", "match": "(?i)\\b(THIS|SUPER)\\b\\^?" },
        { "name": "variable.other.address.twincat-st", "match": "%[IQM][XBWDL*]?[0-9.*]*" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?i)\\b(FUNCTION_BLOCK|PROGRAM|FUNCTION|METHOD|PROPERTY|INTERFACE|ACTION)\\b((?:\\s+(?:PUBLIC|PRIVATE|PROTECTED|INTERNAL|FINAL|ABSTRACT))*)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.pou.twincat-st" },
            "2": { "name": "storage.modifier.twincat-st" },
            "3": { "name": "entity.name.function.twincat-st" }
          }
        },
        {
          "match": "(?i)\\b(TYPE)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.twincat-st" },
            "2": { "name": "entity.name.type.twincat-st" }
          }
        },
        {
          "match": "(?i)\\b(EXTENDS|IMPLEMENTS)\\s+([A-Za-z_][\\w.]*)",
          "captures": {
            "1": { "name": "storage.modifier.twincat-st" },
            "2": { "name": "entity.other.inherited-class.twincat-st" }
          }
        },
        { "name": "storage.type.var.twincat-st", "match": "(?i)\\b(VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT|VAR_GLOBAL|VAR_TEMP|VAR_STAT|VAR_INST|VAR_EXTERNAL|VAR_CONFIG|VAR|END_VAR)\\b" },
        { "name": "storage.modifier.twincat-st", "match": "(?i)\\b(CONSTANT|RETAIN|PERSISTENT|NON_RETAIN|AT|PUBLIC|PRIVATE|PROTECTED|INTERNAL|FINAL|ABSTRACT)\\b" },
        { "name": "storage.type.twincat-st", "match": "(?i)\\b(END_FUNCTION_BLOCK|END_PROGRAM|END_FUNCTION|END_METHOD|END_PROPERTY|END_INTERFACE|END_ACTION|END_TYPE|STRUCT|END_STRUCT|UNION|END_UNION|ARRAY|OF|POINTER|REFERENCE|TO)\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.twincat-st", "match": "(?i)\\b(IF|THEN|ELSIF|ELSE|END_IF|CASE|END_CASE|FOR|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|EXIT|CONTINUE|RETURN|JMP)\\b" },
        { "name": "keyword.operator.word.twincat-st", "match": "(?i)\\b(AND_THEN|OR_ELSE|AND|OR|XOR|NOT|MOD)\\b" }
      ]
    },
    "types": {
      "name": "support.type.primitive.twincat-st",
      "match": "(?i)\\b(BOOL|BIT|BYTE|WORD|DWORD|LWORD|SINT|USINT|INT|UINT|DINT|UDINT|LINT|ULINT|REAL|LREAL|TIME|LTIME|DATE|LDATE|TIME_OF_DAY|TOD|LTOD|DATE_AND_TIME|DT|LDT|STRING|WSTRING|ANY|ANY_NUM|ANY_INT|ANY_REAL|ANY_BIT|PVOID|HRESULT|__XWORD|__UXINT|__XINT|XWORD|UXINT|XINT)\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.twincat-st", "match": ":=|=>|(?i)\\b(S|R|REF)=" },
        { "name": "keyword.operator.comparison.twincat-st", "match": "<>|<=|>=|=|<|>" },
        { "name": "keyword.operator.arithmetic.twincat-st", "match": "\\*\\*|\\+|-|\\*|/" },
        { "name": "keyword.operator.dereference.twincat-st", "match": "\\^" }
      ]
    },
    "calls": {
      "patterns": [
        { "name": "support.function.builtin.twincat-st", "match": "(?i)\\b(ADR|SIZEOF|XSIZEOF|__NEW|__DELETE|__QUERYINTERFACE|__QUERYPOINTER|__ISVALIDREF|MIN|MAX|LIMIT|SEL|MUX|ABS|SQRT|LN|LOG|EXP|EXPT|SIN|COS|TAN|ASIN|ACOS|ATAN|TRUNC|LEN|LEFT|RIGHT|MID|CONCAT|INSERT|DELETE|REPLACE|FIND|SHL|SHR|ROL|ROR|\\w+_TO_\\w+|TO_\\w+)(?=\\s*\\()" },
        { "name": "entity.name.function.call.twincat-st", "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()" }
      ]
    }
  }
}
